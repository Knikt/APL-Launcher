<?xml version="1.0" encoding="utf-8"?>
<!-- APL Launcher for Android TV and Google TV: the remote only, no touch screen needed. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Free Up Memory, Close Unused Apps, the App Switcher's ▲: Android closes apps that are in the background, never
         the one in front. Up to Android 13 only: Android 14 lets an app close nothing but its own processes. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Delete App: Android's own confirmation -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Sleep Timer: on time, whatever app is in front -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Optional, given with adb (docs/android.md): the Control Center over apps without the accessibility service,
         and the apps used lately in the App Switcher -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+: the apps a launcher may see -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- APL TV's Top Shelf (its ShelfProvider) -->
        <provider android:authorities="com.knikt.apltv.shelf" />
    </queries>

    <application
        android:label="APL Launcher"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AplTheme">

        <!-- The Home Screen. HOME + DEFAULT: Android TV can make it its launcher (docs/android.md). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|density|locale|layoutDirection"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The remote's Home and play/pause buttons over every app, and the app in front (KeyService.kt).
             Turned on by the user in Settings › Accessibility, or with adb. -->
        <service
            android:name=".KeyService"
            android:label="@string/key_service_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>

        <!-- Sleep Timer -->
        <receiver android:name=".SleepReceiver" android:exported="false" />

        <!-- The API keys sent by APL Launcher Setup over adb (KeysReceiver.kt). WRITE_SECURE_SETTINGS: only the shell
             (adb) and the system hold it, so no app on the device can send it. -->
        <receiver
            android:name=".KeysReceiver"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.knikt.apllauncher.SET_KEYS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
