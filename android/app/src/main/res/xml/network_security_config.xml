<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher reads artwork and trending lists from many services, some still on plain http -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
