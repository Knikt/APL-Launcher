<?xml version="1.0" encoding="utf-8"?>
<!-- APL Launcher Home Button: the remote's Home and play/pause buttons for APL Launcher, through an accessibility
     service. An app of its own, optional: Google Play Protect blocks a sideloaded app that declares an accessibility
     service, so the launcher installs without it and only who wants the Home button installs this one. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Between APL Launcher and this app only (same key): see the launcher's manifest -->
    <permission
        android:name="com.knikt.apllauncher.permission.HOME_BUTTON"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.knikt.apllauncher.permission.HOME_BUTTON" />
    <!-- Close Unused Apps (up to Android 13) -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The launcher, the device's other launchers, and the apps that can come to the front (the App Switcher's list) -->
    <queries>
        <package android:name="com.knikt.apllauncher" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:allowBackup="false"
        android:theme="@android:style/Theme.NoDisplay">

        <!-- Opened after installing it (Downloader's Open, the app list): straight to Accessibility -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The remote over every app (KeyService.kt): turned on in Settings › Accessibility, or with adb -->
        <service
            android:name=".KeyService"
            android:label="@string/app_name"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/key_service" />
        </service>

        <!-- What the launcher asks of it: sleep, Android's Home/Back…, leave the device's own home on screen -->
        <receiver
            android:name=".CommandReceiver"
            android:exported="true"
            android:permission="com.knikt.apllauncher.permission.HOME_BUTTON">
            <intent-filter>
                <action android:name="com.knikt.apllauncher.home.COMMAND" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
