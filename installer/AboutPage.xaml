<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,34,40,28" MaxWidth="780">
            <TextBlock Style="{StaticResource Text.Title}" Text="About"/>

            <Border Style="{StaticResource Card}" Margin="0,26,0,16" Padding="24,28">
                <StackPanel HorizontalAlignment="Center">
                    <Image x:Name="BigIcon" Width="88" Height="88" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="APL Launcher" FontFamily="{StaticResource Font.Display}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    <TextBlock x:Name="VersionText" Style="{StaticResource Text.Secondary}" FontSize="14" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    <TextBlock Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text2}" TextAlignment="Center" HorizontalAlignment="Center"
                               MaxWidth="560" Margin="0,12,0,0" Text="An Apple TV–style home screen for Samsung, LG and Android TV screens."/>
                    <TextBlock Style="{StaticResource Text.Secondary}" FontSize="13" HorizontalAlignment="Center" Margin="0,10,0,0" Text="Created by Knikt (Gero Corp.)"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="8,6">
                <StackPanel>
                    <Button x:Name="GitHubLink" Style="{StaticResource Button.Row}" Background="Transparent" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Width="26" Height="26" CornerRadius="7" Background="#3A3A3F" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE943;" FontSize="12" Foreground="White"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="APL Launcher on GitHub" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Text.Icon}" Text="&#xE8A7;" FontSize="12" Foreground="{StaticResource Brush.Text3}"/>
                        </Grid>
                    </Button>
                    <Border Style="{StaticResource Separator}" Margin="54,0,14,0"/>
                    <Button x:Name="CompatLink" Style="{StaticResource Button.Row}" Background="Transparent" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Width="26" Height="26" CornerRadius="7" Background="{StaticResource Brush.Green}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE73E;" FontSize="12" Foreground="White"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="What works (compatibility)" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Text.Icon}" Text="&#xE8A7;" FontSize="12" Foreground="{StaticResource Brush.Text3}"/>
                        </Grid>
                    </Button>
                    <Border Style="{StaticResource Separator}" Margin="54,0,14,0"/>
                    <Button x:Name="LicenseLink" Style="{StaticResource Button.Row}" Background="Transparent" Padding="14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Width="26" Height="26" CornerRadius="7" Background="{StaticResource Brush.Gray}" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8A5;" FontSize="12" Foreground="White"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="MIT License" Margin="14,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Style="{StaticResource Text.Icon}" Text="&#xE8A7;" FontSize="12" Foreground="{StaticResource Brush.Text3}"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Secondary}" Margin="4,4,4,0">
                <Run Text="Credits:"/>
                <Run Text="Vetro by andrearicci93; film and series data from TMDB; logos from Fanart.tv."/>
            </TextBlock>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="4,10,4,0" Text="This product uses the TMDB API but is not endorsed or certified by TMDB."/>
            <TextBlock Style="{StaticResource Text.Caption}" Margin="4,4,4,0" Text="APL Launcher is an independent project. It is not affiliated with Apple, Samsung, LG, Google or Amazon; their names and trademarks belong to them."/>
        </StackPanel>
    </ScrollViewer>
</Grid>
