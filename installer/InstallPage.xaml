<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,34,40,28" MaxWidth="780">
            <TextBlock x:Name="PageTitle" Style="{StaticResource Text.Title}" Text="Install"/>
            <TextBlock x:Name="PageSubtitle" Style="{StaticResource Text.Subtitle}" Text="Puts APL Launcher on your Samsung screen in a few minutes."/>

            <!-- ================= FORM ================= -->
            <StackPanel x:Name="FormView" Margin="0,26,0,0">

                <!-- Screen -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Background="{StaticResource Brush.Accent}">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE7F4;" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.H2}" Text="Screen"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="Your Samsung screen, turned on and on the same network as this PC."/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Text.Section}" Text="IP address of the screen" Margin="2,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="240"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="IpBox" Tag="192.168.1.50"/>
                            <Button x:Name="FindButton" Grid.Column="1" Style="{StaticResource Button.Secondary}" Margin="10,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE721;" FontSize="13" Margin="0,1,9,0"/>
                                    <TextBlock Text="Find"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                        <Grid Margin="2,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid x:Name="VetroMark" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="VetroText" Style="{StaticResource Text.Body}"/>
                                <TextBlock x:Name="VetroHelp" Style="{StaticResource Text.Secondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="ScanPanel" Visibility="Collapsed" Margin="0,18,0,0"/>
                    </StackPanel>
                </Border>

                <!-- This PC -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Background="{StaticResource Brush.Gray}">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE770;" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.H2}" Text="This PC"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="The tools that build and sign the launcher."/>
                            </StackPanel>
                            <Button x:Name="CheckAgain" Grid.Column="2" Style="{StaticResource Button.Secondary}" Content="Check again" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel x:Name="PcRows"/>
                    </StackPanel>
                </Border>

                <!-- Options -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource IconTile}" Background="{StaticResource Brush.Purple}">
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE713;" Foreground="White"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.H2}" Text="Options"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="All optional. Leave a key empty to do without that feature."/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,12,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="290"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Label}" Text="TMDB key"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="The live Top Shelf, and artwork for films and series."/>
                            </StackPanel>
                            <TextBox x:Name="TmdbBox" Grid.Column="1" Tag="Not set" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Separator}"/>
                        <Grid Margin="0,12,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="290"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Label}" Text="YouTube key"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="Shows YouTube trends in the Top Shelf."/>
                            </StackPanel>
                            <TextBox x:Name="YouTubeBox" Grid.Column="1" Tag="Not set" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Separator}"/>
                        <Grid Margin="0,12,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="290"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Fanart.tv key"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="HD logos and textless backgrounds."/>
                            </StackPanel>
                            <TextBox x:Name="FanartBox" Grid.Column="1" Tag="Not set" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Style="{StaticResource Separator}"/>

                        <StackPanel Margin="0,12,0,12">
                            <TextBlock Style="{StaticResource Text.Label}" Text="Websites as apps"/>
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="They appear as apps on the home screen and open in Samsung Internet."/>
                            <StackPanel x:Name="SitesList" Margin="0,12,0,0"/>
                            <Button x:Name="AddSite" Style="{StaticResource Button.Plain}" HorizontalAlignment="Left" Margin="-10,2,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE710;" FontSize="12" Margin="0,1,8,0"/>
                                    <TextBlock Text="Add a website"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <Border Style="{StaticResource Separator}"/>

                        <Grid Margin="0,14,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Also install APL TV"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap" Text="An IPTV player in the same style, for your own M3U playlists and Xtream accounts. It comes with no channels. Uses the TMDB key above."/>
                            </StackPanel>
                            <CheckBox x:Name="AplTvToggle" Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="True"/>
                        </Grid>
                        <Border Style="{StaticResource Separator}"/>

                        <Grid Margin="0,14,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.Label}" Text="Debloat the screen after installing"/>
                                <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0">
                                    <Run Text="Optimize removes Samsung's ads, viewing tracking and the apps you don't use. It shows the list first; Restore undoes it."/>
                                    <Hyperlink NavigateUri="apl:optimize"><Run Text="About Optimize"/></Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <CheckBox x:Name="OptimizeAfter" Grid.Column="1" Style="{StaticResource Toggle}" IsChecked="True"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ================= PROGRESS ================= -->
            <StackPanel x:Name="ProgressView" Visibility="Collapsed" Margin="0,26,0,0">
                <Border Style="{StaticResource Card}" Padding="22,20,22,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock x:Name="OverallText" Style="{StaticResource Text.Secondary}"/>
                            <TextBlock x:Name="OverallPercent" Style="{StaticResource Text.Secondary}" HorizontalAlignment="Right"/>
                        </Grid>
                        <ProgressBar x:Name="OverallBar"/>
                        <StackPanel x:Name="Steps" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
                <Border x:Name="FailCard" Style="{StaticResource Card}" Background="{StaticResource Brush.RedTint}" BorderBrush="{StaticResource Brush.RedTintBorder}" Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="FailMark" VerticalAlignment="Top" Margin="0,1,0,0"/>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                            <TextBlock x:Name="FailTitle" Style="{StaticResource Text.Label}" FontSize="15" Text="The installation stopped"/>
                            <TextBlock x:Name="FailText" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text2}" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="RetryButton" Style="{StaticResource Button.Primary}" Content="Try again" Margin="0,0,10,0"/>
                                <Button x:Name="BackButton" Style="{StaticResource Button.Secondary}" Content="Change the settings"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <Expander x:Name="Details" Header="Details" Margin="2,0,0,0">
                    <TextBox x:Name="LogBox" Style="{StaticResource LogBox}"/>
                </Expander>
            </StackPanel>

            <!-- ================= FINISH ================= -->
            <StackPanel x:Name="FinishView" Visibility="Collapsed" Margin="0,26,0,0">
                <Border Style="{StaticResource Card}" Padding="22,22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid x:Name="DoneMark" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.H2}" FontSize="20" Text="APL Launcher is installed"/>
                            <TextBlock Style="{StaticResource Text.Secondary}" FontSize="14" Margin="0,3,0,0" Text="Two things are left to do, only once."/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 1. On the screen -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Brush.Accent}" VerticalAlignment="Top">
                            <TextBlock Text="1" FontSize="15" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,4,0,0">
                            <TextBlock Style="{StaticResource Text.H2}" Text="On the screen"/>
                            <TextBlock x:Name="ScreenPath" Style="{StaticResource Text.Body}" Foreground="{StaticResource Brush.Text2}" Margin="0,6,0,12"/>
                            <Border CornerRadius="12" Background="{StaticResource Brush.Input}" Padding="16,0">
                                <StackPanel>
                                    <Grid Height="44">
                                        <TextBlock x:Name="SmartHubName" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,90,0"/>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="7" Background="#3A3A3F" Padding="10,3,10,4">
                                            <TextBlock Text="Off" FontSize="13" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <Border Style="{StaticResource Separator}" Background="#34353B"/>
                                    <Grid Height="44">
                                        <TextBlock x:Name="LastAppName" Style="{StaticResource Text.Body}" VerticalAlignment="Center" Margin="0,0,90,0"/>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="7" Background="#1E5631" Padding="10,3,10,4">
                                            <TextBlock Text="On" FontSize="13" FontWeight="SemiBold" Foreground="#5BE07F"/>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. In Vetro -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="30" Height="30" CornerRadius="15" Background="{StaticResource Brush.Accent}" VerticalAlignment="Top">
                            <TextBlock Text="2" FontSize="15" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,1"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,4,0,0">
                            <Grid>
                                <TextBlock Style="{StaticResource Text.H2}" Text="In Vetro" VerticalAlignment="Center"/>
                                <Button x:Name="OpenVetro" Style="{StaticResource Button.Secondary}" HorizontalAlignment="Right" Margin="0,-4,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Open Vetro"/>
                                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8A7;" FontSize="12" Margin="9,1,0,0"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <StackPanel x:Name="VetroSteps" Margin="0,10,0,0"/>
                            <Border Style="{StaticResource Separator}" Margin="0,8,0,16"/>
                            <TextBlock x:Name="RemapIntro" Style="{StaticResource Text.Secondary}" Margin="0,0,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="RemapButton" Style="{StaticResource Button.Primary}" Content="Done — set up the buttons"/>
                            </StackPanel>
                            <StackPanel x:Name="RemapStatus" Margin="0,14,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Next: Optimize -->
                <Border x:Name="ContinueCard" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" Background="{StaticResource Brush.Orange}" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE945;" Foreground="White"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Label}" FontSize="15" Text="Then, optimize the screen"/>
                            <TextBlock Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" Text="You asked to optimize the screen after installing."/>
                        </StackPanel>
                        <Button x:Name="ContinueButton" Grid.Column="2" Style="{StaticResource Button.Secondary}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Continue to Optimize"/>
                                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE76C;" FontSize="11" Margin="9,1,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <Button x:Name="NewInstall" Style="{StaticResource Button.Plain}" HorizontalAlignment="Left" Margin="-10,0,0,0" Content="Back to the installation settings"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <!-- ================= FOOTER (form only) ================= -->
    <Border x:Name="Footer" Grid.Row="1" Background="#15161A" BorderBrush="{StaticResource Brush.Separator}" BorderThickness="0,1,0,0">
        <Grid Margin="40,14,40,14" MaxWidth="780">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <Grid x:Name="FooterMark" Width="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="FooterHint" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" MaxWidth="480"/>
            </StackPanel>
            <Button x:Name="InstallButton" Grid.Column="1" Style="{StaticResource Button.Large}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE896;" FontSize="14" Margin="0,1,10,0"/>
                    <TextBlock Text="Install"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Grid>
