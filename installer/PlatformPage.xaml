<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="40,34,40,28" MaxWidth="780">
            <TextBlock Style="{StaticResource Text.Title}" Text="Your TV"/>
            <TextBlock Style="{StaticResource Text.Subtitle}" Text="Choose your TV and tell if it is rooted: the Setup does the rest."/>

            <!-- The three kinds of TV -->
            <Border Style="{StaticResource Card}" Margin="0,26,0,16" Padding="10,10">
                <StackPanel x:Name="Options"/>
            </Border>

            <!-- Rooted or not -->
            <Border x:Name="RootCard" Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource IconTile}" Background="{StaticResource Brush.Indigo}" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE72E;" Foreground="White"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                            <TextBlock x:Name="RootTitle" Style="{StaticResource Text.H2}"/>
                            <TextBlock x:Name="RootText" Style="{StaticResource Text.Secondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox x:Name="RootToggle" Grid.Column="2" Style="{StaticResource Toggle}" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Style="{StaticResource Separator}" Margin="0,16,0,14"/>
                    <TextBlock x:Name="ListTitle" Style="{StaticResource Text.Label}" Margin="2,0,0,6"/>
                    <StackPanel x:Name="List"/>
                    <TextBlock x:Name="HowText" Style="{StaticResource Text.Secondary}" Margin="2,10,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Without a PC -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource IconTile}" Background="{StaticResource Brush.Teal}" VerticalAlignment="Top">
                        <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE8EA;" Foreground="White"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource Text.H2}" Text="Without a PC"/>
                        <TextBlock x:Name="PhoneText" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>

    <Border x:Name="Footer" Grid.Row="1" Background="#15161A" BorderBrush="{StaticResource Brush.Separator}" BorderThickness="0,1,0,0">
        <Grid Margin="40,14,40,14" MaxWidth="780">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterHint" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="0,0,20,0" TextWrapping="Wrap"/>
            <Button x:Name="ContinueButton" Grid.Column="1" Style="{StaticResource Button.Large}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ContinueText" Text="Continue"/>
                    <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE76C;" FontSize="12" Margin="10,1,0,0"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Grid>
